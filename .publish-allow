# Exceptions for scripts/check-publishable.py (this repository is mirrored to GitHub).
# Every 10.x and 172.16-31.x address is refused unless listed here. List only
# documentation examples, Kubernetes defaults and test fixtures: never a real
# deployment's LAN, node or service address.
#
#   value <regex>              the whole matched value may appear anywhere
#   path <glob> <category>     a category may appear in matching files

# Kubernetes defaults: service CIDR 10.96.0.0/12, pod CIDR 10.244.0.0/16.
value 10\.96\.\d{1,3}\.\d{1,3}(/\d{1,2})?
value 10\.244\.\d{1,3}\.\d{1,3}(/\d{1,2})?
# The RFC 1918 blocks themselves and the documentation examples used in tests and docs.
value 10\.0\.\d{1,3}\.\d{1,3}(/\d{1,2})?
value 10\.1\.[12]\.\d{1,3}
value 10\.8\.0\.0/14
value 10\.9\.9\.9
value 10\.18\.0\.5
value 10\.30\.1\.\d{1,3}(/\d{1,2})?
value 172\.16\.\d{1,3}\.\d{1,3}(/\d{1,2})?

# A fake key the log redaction test must remove.
path internal/telemetry/redact_test.go private-key
