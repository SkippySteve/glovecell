        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "apc_provider_lease_active",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 9,
        "y": 3,
        "w": 5,
        "h": 4
      }
    },
    {
      "title": "GitHub lease",
      "type": "stat",
      "description": "The GitHub broker's published lease status.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
