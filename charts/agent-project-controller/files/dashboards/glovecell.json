    {
      "title": "Reconciles • rate and p95",
      "type": "timeseries",
      "description": "Reconciliation attempts per second by status (success or retry) and p95 duration.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(workspace_reconcile_attempts_total[$__rate_interval]))",
          "legendFormat": "{{status}} / s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,status) (rate(workspace_reconcile_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{status}} (s)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
