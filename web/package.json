{
  "name": "agent-project-controller-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Operator console built with OpenUI components; compiled into internal/web/dist.",
  "scripts": {
    "theme": "node scripts/theme-css.mjs",
    "build": "npm run theme && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@openuidev/lang-core": "0.3.2",
    "@openuidev/react-headless": "0.16.3",
    "@openuidev/react-lang": "0.3.0",
    "@openuidev/react-ui": "0.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@ag-ui/core": "1.0.3"
  }
}
