#!/bin/sh
# Codex over ACP for the session hub (docs/session-hub.md). codex-acp drives
# the cell's brokered Codex bridge (apc-codex: the operator's lease, project
# directory only, no sign-in), never its bundled Codex or an API key.
unset CODEX_API_KEY OPENAI_API_KEY
export CODEX_PATH=/usr/local/bin/apc-codex NO_BROWSER=1
exec node /opt/acp-adapters/node_modules/@agentclientprotocol/codex-acp/dist/index.js "$@"
