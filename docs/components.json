{
  "_doc": "Every agent-project-controller subcommand and where it runs. See docs/in-cluster.md. internal/installation/incluster_test.go fails if a subcommand is missing here, if a chart component has no template, or if the exception list grows.",
  "components": [
    {"command": "controller", "class": "chart", "template": "deployment.yaml"},

    {"command": "proxy", "class": "controller-pod", "note": "project egress proxy pod created by the controller"},
    {"command": "proxy-ready", "class": "controller-pod", "note": "proxy readiness probe"},
    {"command": "reader", "class": "controller-pod", "note": "read-only project reader pod"},
    {"command": "download-grant", "class": "controller-pod", "note": "run in the proxy pod"},
    {"command": "bootstrap", "class": "controller-pod", "note": "worker init"},
    {"command": "credential", "class": "controller-pod", "note": "worker credential helper"},
    {"command": "preflight", "class": "controller-pod", "note": "worker preflight"},
    {"command": "fetch", "class": "controller-pod", "note": "run by the controller inside a worker"},
    {"command": "put", "class": "controller-pod", "note": "run by the controller inside a worker"},
    {"command": "register-projects", "class": "controller-pod", "note": "run by the controller inside a worker"},
    {"command": "t3-serve", "class": "controller-pod", "note": "inside a worker"},
    {"command": "t3-managed", "class": "controller-pod", "note": "inside a worker"},
    {"command": "t3-stop", "class": "controller-pod", "note": "inside a worker"},
    {"command": "t3-relay", "class": "controller-pod", "note": "inside a worker"},
    {"command": "t3-codex", "class": "controller-pod", "note": "inside a worker"},

    {"command": "t3", "class": "operator-cli", "note": "one-shot, operator's own identity; nothing depends on it running"},
    {"command": "connect", "class": "operator-cli", "note": "one-shot, operator's own identity"},
    {"command": "model", "class": "operator-cli", "note": "one-shot"},
    {"command": "exec", "class": "operator-cli", "note": "one-shot"},
    {"command": "version", "class": "operator-cli", "note": "one-shot"},

    {"command": "provider-broker", "class": "cluster-exception",
     "where": "steve/opnsense-kubernetes-bgp infra/agent-workplace/provider-broker",
     "replacement": "chart template (own Deployment and ServiceAccount, off by default)",
     "tracking": "docs/in-cluster.md, Migration"},
    {"command": "github-broker", "class": "cluster-exception",
     "where": "steve/opnsense-kubernetes-bgp infra/agent-workplace/github-broker",
     "replacement": "chart template (own Deployment, holds the GitHub App credential, off by default)",
     "tracking": "docs/in-cluster.md, Migration"},
    {"command": "hubspoke", "class": "cluster-exception",
     "where": "steve/opnsense-kubernetes-bgp infra/agent-workplace/orca-hub",
     "replacement": "chart hub Deployment (values hubspoke.hub), separate pod from the controller",
     "tracking": "docs/in-cluster.md, Migration"},
    {"command": "register", "class": "desktop-exception",
     "where": "operator desktop: systemd user unit agent-project-controller-register, runs with the operator's admin kubeconfig",
     "replacement": "in-cluster hubspoke enrolls every Ready cell and its spec.repositories with the Orca hub; the desktop Orca app connects to the hub as a client",
     "tracking": "docs/in-cluster.md, Migration"}
  ]
}
